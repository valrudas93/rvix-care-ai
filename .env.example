# ─────────────────────────────────────────────────────────────────────────────
# VARIME — Variables de entorno del monorepo
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos ─────────────────────────────────────────────────────────────
POSTGRES_USER=cerviai
POSTGRES_PASSWORD=cerviai
POSTGRES_DB=cervical_ai_db

# ── Backend ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://cerviai:cerviai@db:5432/cervical_ai_db
SECRET_KEY=change-this-to-a-random-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_ENV=development
DEBUG=True
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# ── Modelos ViT ───────────────────────────────────────────────────────────────
VIT_MODEL_PATH=app/ai_models/vision_models/vit_sipakmed_final.keras
VIT_MODEL_PATH2=app/ai_models/vision_models/vit_tcia_heterogeneidad_final.keras
IMAGE_SIZE=224
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic           # opciones: mock | anthropic | openai | mistral | llama
ANTHROPIC_API_KEY=               # requerido si LLM_PROVIDER=anthropic
OPENAI_API_KEY=                  # requerido si LLM_PROVIDER=openai
LLAMA_MODEL_PATH=                # requerido si LLM_PROVIDER=llama

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
